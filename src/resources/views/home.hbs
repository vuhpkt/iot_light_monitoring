<div class="content-header">
    <div class="content-title">Dashboard</div>
    <div class="content-subtitle">Overview of all devices</div>
</div>
<div class="table-wrapper">
    <div class="table grid">
        <div class="table-header row no-gutters">
            <div class="col c-2">Name</div>
            <div class="col c-3">Location</div>
            <div class="col c-2">Value (lux)</div>
            <div class="col c-5">Measured at</div>
        </div>
        {{#each devices}}
        <div class="table-row row no-gutters">
            <div class="table-item col c-2">{{this.name}}</div>
            <div class="table-item col c-3">{{this.location}}</div>
            <div class="table-item table-item--value col c-2">{{this.latestValue}}</div>
            <div class="table-item col c-5">{{this.latestMeasurement}}</div>
        </div>
        <div class="table-row row no-gutters">
            <div class="table-item col c-2">{{this.name}}</div>
            <div class="table-item col c-3">{{this.location}}</div>
            <div class="table-item table-item--value col c-2">{{this.latestValue}}</div>
            <div class="table-item col c-5">{{this.latestMeasurement}}</div>
        </div>
        {{/each}}
    </div>
</div>
<div class="chart-wrapper">
    <div class="chart"></div>
</div>