<div class="content-header">
    <div class="content-title">History</div>
    <div class="content-subtitle">History of all devices</div>
</div>
<div class="table-wrapper">
    <div class="table table--history grid">
        <div class="table-header row no-gutters">
            <div class="col c-1">ID <i class="fa-solid fa-chevron-down"></i></div>
            <div class="col c-2">Name <i class="fa-solid fa-chevron-down"></i></div>
            <div class="col c-2">Location <i class="fa-solid fa-chevron-down"></i></div>
            <div class="col c-2">Value (lux) <i class="fa-solid fa-chevron-down"></i></div>
            <div class="col c-5">Measured at <i class="fa-solid fa-chevron-down"></i></div>
        </div>
        {{#each sensorData}}
        <div class="table-row row no-gutters">
            <div class="table-item col c-1">{{this.id}}</div>
            <div class="table-item col c-2">Light 1</div>
            <div class="table-item col c-2">Room 1</div>
            <div class="table-item table-item--value col c-2">{{this.value}}</div>
            <div class="table-item col c-5">{{this.measured_at}}</div>
        </div>
        {{/each}}
    </div>
</div>