<h2 class="mt-4">// Bộ lọc</h2>
<table class="table mt-4">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Thiết bị</th>
                <th scope="col">Địa điểm</th>
                <th scope="col">Giá trị (lux)</th>
                <th scope="col">Thời điểm đo</th>
            </tr>
        </thead>
        <tbody>
            {{#each sensorData}}
            <tr>
                <th scope="row">{{this.id}}</th>
                <td>Thiết bị 1</td>
                <td>Phòng khách</td>
                <td>{{this.value}}</td>
                <td>{{this.measured_at}}</td>
            </tr>
            {{/each}}

